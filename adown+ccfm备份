# Ultralytics YOLO11 - ADown + CCFM Lightweight version
nc: 80
scales:
  n: [0.50, 0.25, 1024]

backbone:
  # [from, repeats, module, args]
  - [-1, 1, Conv, [64, 3, 2]] # 0-P1/2
  - [-1, 1, ADown, [128]]     # 1-P2/4
  - [-1, 2, C3k2, [256, False, 0.25]]
  - [-1, 1, ADown, [256]]     # 3-P3/8
  - [-1, 2, C3k2, [512, False, 0.25]]
  - [-1, 1, ADown, [512]]     # 5-P4/16
  - [-1, 2, C3k2, [512, True]]
  - [-1, 1, ADown, [1024]]    # 7-P5/32
  - [-1, 2, C3k2, [1024, True]]
  - [-1, 1, SPPF, [1024, 5]]  # 9
  - [-1, 2, C2PSA, [1024]]    # 10

head:
  - [-1, 1, nn.Upsample, [None, 2, "nearest"]]
  - [[-1, 6], 1, Concat, [1]] # cat backbone P4
  - [-1, 2, CCFM, [512]]       # 13 (替换 C3k2)

  - [-1, 1, nn.Upsample, [None, 2, "nearest"]]
  - [[-1, 4], 1, Concat, [1]] # cat backbone P3
  - [-1, 2, CCFM, [256]]       # 16 (P3/8-small, 替换 C3k2)

  - [-1, 1, ADown, [256]]      # 17 (下采样用 ADown)
  - [[-1, 13], 1, Concat, [1]] # cat head P4
  - [-1, 2, CCFM, [512]]       # 19 (P4/16-medium, 替换 C3k2)

  - [-1, 1, ADown, [512]]      # 20 (下采样用 ADown)
  - [[-1, 10], 1, Concat, [1]] # cat head P5
  - [-1, 2, CCFM, [1024]]      # 22 (P5/32-large, 替换 C3k2)

  - [[16, 19, 22], 1, Detect, [nc]]